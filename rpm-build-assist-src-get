#!/bin/sh
# rpm-build-assist-src-get - prepare a dist-git checkout for mock's SCM plugin.
#
# mock's SCM plugin invokes this as its "distgit_src_get" command, running it
# on the host in the freshly checked-out package directory. It:
#
#   1. Expands the rpmautospec %autorelease / %autochangelog macros from the
#      git history, the way Koji and fedpkg do.
#   2. Fetches any sources that are published online (via spectool).
#   3. Fetches sources stored only in a lookaside cache: a Fedora-style
#      "sources" manifest is fetched with fedpkg, and an rpkg "rpkg.conf" with
#      rpkg. Specs that reference such files by bare name have no URL spectool
#      could use.
#   4. Runs any repository-provided source-assembly script (a name ending in
#      "source.sh" or "sources.sh") to assemble sources not available online.
#
# Missing sources are intentionally NOT diagnosed here: if a source the spec
# references is still absent afterwards, mock's src.rpm assembly fails and
# reports exactly which file is missing.

set -eu

spec="${1:-}"
if [ -z "$spec" ]; then
    echo "usage: $(basename "$0") SPECFILE" >&2
    exit 2
fi

# Expand rpmautospec's %autorelease / %autochangelog from the git history.
# mock's SCM plugin does not run rpmautospec, so without this the rpmautospec
# macros fall back to release 1 with a placeholder changelog. This runs in the
# checkout directory, where the .git history rpmautospec reads is present.
# Specs that don't use rpmautospec are left byte-for-byte untouched.
if grep -qE '%autorelease|%autochangelog' "$spec"; then
    if command -v rpmautospec >/dev/null 2>&1; then
        processed="$spec.rpmautospec"
        if rpmautospec process-distgit "$spec" "$processed"; then
            mv -f "$processed" "$spec"
        else
            rm -f "$processed"
            echo "warning: rpmautospec failed for $spec; release and" \
                 "changelog may be wrong" >&2
        fi
    else
        echo "warning: $spec uses rpmautospec but rpmautospec is not" \
             "installed; release and changelog may be wrong" >&2
    fi
fi

# Fetch sources that are listed with a URL. spectool ignores non-URL (locally
# assembled) sources and, in current versions, always exits 0 even when a
# download fails -- so its exit status is not a reliable signal and we do not
# treat a spectool failure as fatal. A genuinely missing source surfaces later
# during src.rpm assembly.
spectool -g "$spec" || echo "warning: spectool exited non-zero; continuing" >&2

# Fetch sources that live only in a lookaside cache. spectool cannot get these
# because the spec lists them by bare filename, with no URL. The manifest/config
# files present in the checkout tell us which cache to ask, and each is handled
# independently so a repository configured for both is fully served. As with
# spectool, failures (offline, an unrecognized remote) are not fatal: a
# genuinely missing source surfaces during src.rpm assembly.
if [ -f sources ]; then
    if command -v fedpkg >/dev/null 2>&1; then
        name=$(rpmspec -q --srpm --qf '%{name}\n' "$spec" 2>/dev/null | head -1)
        [ -n "$name" ] || name=$(sed -n 's/^Name:[[:space:]]*//p' "$spec" | head -1)
        echo "Fetching lookaside sources with fedpkg (--name $name)"
        fedpkg --name "$name" sources \
            || echo "warning: fedpkg sources failed; continuing" >&2
    else
        echo "warning: a 'sources' manifest is present but fedpkg is not" \
             "installed; lookaside sources may be missing" >&2
    fi
fi
if [ -f rpkg.conf ]; then
    if command -v rpkg >/dev/null 2>&1; then
        echo "Fetching lookaside sources with rpkg"
        rpkg sources || echo "warning: rpkg sources failed; continuing" >&2
    else
        echo "warning: an 'rpkg.conf' is present but rpkg is not installed;" \
             "lookaside sources may be missing" >&2
    fi
fi

# Assemble any remaining sources using a repository-provided script. The exact
# name varies between projects (commonly ending in "source.sh" or "sources.sh").
# Their exit status is unreliable -- some try to upload archives to a lookaside
# cache and fail when offline -- so, like spectool, a non-zero exit is ignored.
# If a source is genuinely missing, src.rpm assembly fails and reports it.
for script in ./*source*.sh; do
    # If the glob matched nothing it stays literal; skip that case.
    [ -e "$script" ] || continue
    echo "Running source assembly script: $script"
    /bin/sh "$script" || continue
done
