class MockBuildAssistant:
    """Main class for managing RPM builds with mock"""

    def __init__(self, config_file: str, verbose: bool = False, localrepo: Optional[str] = None):
        """
        Initialize the build assistant

        Args:
            config_file: Path to the YAML configuration file
            verbose: Enable verbose logging
            localrepo: Path to local repository (from CLI, takes precedence over config)
        """
        self.config_file = config_file
        self.verbose = verbose
        self.config: Dict[str, Any] = {}
        self.localrepo_path: Optional[Path] = Path(localrepo) if localrepo else None
        self.mock_defines: List[str] = []
        self.addrepo_urls: List[str] = []

        # Setup logging
        log_level = logging.DEBUG if verbose else logging.INFO
        logging.basicConfig(
            level=log_level,
            format='%(asctime)s - %(levelname)s - %(message)s'
        )
        self.logger = logging.getLogger(__name__)

    def load_config(self) -> None:
        """Load and validate the YAML configuration file"""
        self.logger.info(f"Loading configuration from {self.config_file}")

        try:
            with open(self.config_file, 'r') as f:
                self.config = yaml.safe_load(f)
        except FileNotFoundError:
            self.logger.error(f"Configuration file not found: {self.config_file}")
            sys.exit(1)
        except yaml.YAMLError as e:
            self.logger.error(f"Error parsing YAML: {e}")
            sys.exit(1)

        # Validate required fields
        if 'base' not in self.config:
            self.logger.error("Configuration must include 'base' field")
            sys.exit(1)
        if 'build' not in self.config:
            self.logger.error("Configuration must include 'build' field")
            sys.exit(1)

        # Process addrepo field (optional)
        if 'addrepo' in self.config:
            addrepo = self.config['addrepo']
            # Support both single URL string and list of URLs
            if isinstance(addrepo, str):
                self.addrepo_urls = [addrepo]
            elif isinstance(addrepo, list):
                self.addrepo_urls = addrepo
            else:
                self.logger.error("'addrepo' field must be a string or list of strings")
                sys.exit(1)
            self.logger.info(f"Additional repositories: {self.addrepo_urls}")

        self.logger.debug(f"Configuration loaded: {self.config}")

    def setup_install_options(self) -> None:
        """Process install section and setup mock defines for special install types"""
        if 'install' not in self.config:
            self.logger.info("No install section found, using default paths")
            return

        install_config = self.config['install']
        install_type = install_config.get('type', '')

        self.logger.info(f"Processing install type: {install_type}")

        if install_type == 'flatpak':
            self.logger.info("Configuring for flatpak build (prefix=/app)")
            self._setup_flatpak_macros()
        elif install_type == 'software-collection':
            collection = install_config.get('collection')
            if not collection:
                self.logger.error("Software collection type requires 'collection' name")
                sys.exit(1)
            self.logger.info(f"Configuring for software collection: {collection}")
            self._setup_scl_macros(collection)
        elif install_type == 'package-collection':
            collection = install_config.get('collection')
            if not collection:
                self.logger.error("package-collection type requires 'collection' name")
                sys.exit(1)
            self.logger.info(f"Configuring for package-collection build: {collection}")
            self._setup_package_collection_macros(collection)
        elif install_type in ['container', 'install-media', 'live-usb']:
            self.logger.info(f"Install type '{install_type}' uses standard paths")
        else:
            self.logger.warning(f"Unknown install type: {install_type}")

    def _setup_flatpak_macros(self) -> None:
        """Setup RPM macros for flatpak builds (prefix=/app)"""
        # Flatpak uses /app as the prefix
        flatpak_macros = [
            '_prefix /app',
            '_exec_prefix /app',
            '_bindir /app/bin',
            '_sbindir /app/sbin',
            '_libexecdir /app/libexec',
            '_datadir /app/share',
            '_sysconfdir /app/etc',
            '_sharedstatedir /app/com',
            '_localstatedir /app/var',
            '_libdir /app/%{_lib}',
            '_includedir /app/include',
            '_infodir /app/share/info',
            '_mandir /app/share/man',
        ]

        for macro in flatpak_macros:
            self.mock_defines.append(f"--define={macro}")
            self.logger.debug(f"Added macro: {macro}")

    def _setup_scl_macros(self, collection: str) -> None:
        """Setup RPM macros for software collection builds"""
        # Software collections use /opt/{collection} as the prefix
        scl_prefix = f"/opt/{collection}"
        scl_macros = [
            f'_prefix {scl_prefix}',
            f'_exec_prefix {scl_prefix}',
            f'_bindir {scl_prefix}/bin',
            f'_sbindir {scl_prefix}/sbin',
            f'_libexecdir {scl_prefix}/libexec',
            f'_datadir {scl_prefix}/share',
            f'_sysconfdir {scl_prefix}/etc',
            f'_sharedstatedir {scl_prefix}/com',
            f'_localstatedir {scl_prefix}/var',
            f'_libdir {scl_prefix}/%{{_lib}}',
            f'_includedir {scl_prefix}/include',
            f'_infodir {scl_prefix}/share/info',
            f'_mandir {scl_prefix}/share/man',
            f'scl {collection}',
        ]

        for macro in scl_macros:
            self.mock_defines.append(f"--define={macro}")
            self.logger.debug(f"Added macro: {macro}")

    def _setup_package_collection_macros(self, collection: str) -> None:
        """Setup RPM macros for package-collection builds with gcc rpath support"""
        # Use /opt/{collection} as the prefix, similar to software collections
        # but configure build flags to use rpath for library discovery
        install_prefix = f"/opt/{collection}"

        # Standard path macros
        collection_macros = [
            f'_prefix {install_prefix}',
            f'_exec_prefix {install_prefix}',
            f'_bindir {install_prefix}/bin',
            f'_sbindir {install_prefix}/sbin',
            f'_libexecdir {install_prefix}/libexec',
            f'_datadir {install_prefix}/share',
            f'_sysconfdir {install_prefix}/etc',
            f'_sharedstatedir {install_prefix}/com',
            f'_localstatedir {install_prefix}/var',
            f'_libdir {install_prefix}/%{{_lib}}',
            f'_includedir {install_prefix}/include',
            f'_infodir {install_prefix}/share/info',
            f'_mandir {install_prefix}/share/man',
        ]

        # Add build flags for rpath using $ORIGIN and $LIB
        # $ORIGIN - directory containing the binary/library
        # $LIB - expands to "lib" or "lib64" depending on platform
        # These flags ensure that binaries built with this prefix can find
        # their shared libraries without needing LD_LIBRARY_PATH
        rpath_flags = [
            # Set LD_RUN_PATH for the collection's prefix
            r'''set_build_flags CFLAGS="\${CFLAGS:-%{build_cflags}}" ; export CFLAGS ; \
  CXXFLAGS="\${CXXFLAGS:-%{build_cxxflags}}" ; export CXXFLAGS ; \
  FFLAGS="\${FFLAGS:-%{build_fflags}}" ; export FFLAGS ; \
  FCFLAGS="\${FCFLAGS:-%{build_fflags}}" ; export FCFLAGS ; \
  VALAFLAGS="\${VALAFLAGS:-%{build_valaflags}}" ; export VALAFLAGS ;%{?build_rustflags:
  RUSTFLAGS="\${RUSTFLAGS:-%{build_rustflags}}" ; export RUSTFLAGS ;} \
  LDFLAGS="\${LDFLAGS:-%{build_ldflags}}" ; export LDFLAGS ; \
  LT_SYS_LIBRARY_PATH="\${LT_SYS_LIBRARY_PATH:-%_libdir:}" ; export LT_SYS_LIBRARY_PATH ; \
  CC="\${CC:-%{__cc}}" ; export CC ; \
  CXX="\${CXX:-%{__cxx}}" ; export CXX ; \
  ''' + \
            f"LD_RUN_PATH='\\$ORIGIN/../\\$LIB' ; export LD_RUN_PATH"
        ]

        # Combine all macros
        all_macros = collection_macros + rpath_flags

        for macro in all_macros:
            self.mock_defines.append(f"--define={macro}")
            self.logger.debug(f"Added macro: {macro}")

    def setup_localrepo(self) -> None:
        """
        Setup the local repository directory.

        Precedence:
        1. CLI argument (--localrepo)
        2. YAML config (localrepo key)
        3. Temporary directory (default)
        """

        # Determine source of localrepo path
        if self.localrepo_path:
            # expanduser() handles ~ for home directory
            self.localrepo_path = self.localrepo_path.expanduser().resolve()
            self.localrepo_path.mkdir(parents=True, exist_ok=True)
            self.logger.info(f"Using local repository from argument: {self.localrepo_path}")
        elif 'localrepo' in self.config:
            self.localrepo_path = Path(self.config['localrepo']).expanduser().resolve()
            self.localrepo_path.mkdir(parents=True, exist_ok=True)
            self.logger.info(f"Using local repository from configuration: {self.localrepo_path}")
        else:
            # Create temporary directory
            self.localrepo_path = Path(tempfile.mkdtemp(prefix='mock-localrepo-'))
            self.logger.info(f"Created temporary local repository at: {self.localrepo_path}")


    def build_packages(self) -> None:
        """Build all packages defined in the build section"""
        base_config = self.config['base']

        for build_source in self.config['build']:
            source_type = build_source.get('type', 'dist-git')
            source_url = build_source.get('url', '')
            packages = build_source.get('packages', [])

            if not source_url:
                self.logger.error("Build source missing 'url' field")
                continue

            self.logger.info(f"Processing build source: {source_url} (type: {source_type})")

            for package_spec in packages:
                # Parse package:branch format
                if ':' in package_spec:
                    package, branch = package_spec.split(':', 1)
                else:
                    package = package_spec
                    branch = 'main'

                self.logger.info(f"Building package: {package} (branch: {branch})")
                self._build_package(base_config, source_type, source_url, package, branch)

    def _build_package(self, base_config: str, source_type: str,
                       source_url: str, package: str, branch: str) -> None:
        """Build a single package using mock"""
        # Construct the full repository URL
        if not source_url.endswith('/'):
            source_url += '/'
        repo_url = f"{source_url}{package}"

        self.logger.debug(f"Repository URL: {repo_url}")

        # Build mock command
        mock_cmd = [
            'mock',
            '-r', base_config,
            '--buildsrpm',
            f'--resultdir={self.localrepo_path}/srpm',
            '--scm-enable',
            '--scm-option', f'method={source_type}' if source_type != 'dist-git' else 'method=distgit',
            '--scm-option', f'package={package}',
            '--scm-option', f'branch={branch}',
            '--scm-option', f'spec={package}.spec',
        ]

        # Add SCM get command based on type
        if source_type == 'dist-git':
            mock_cmd.extend([
                '--scm-option', 'write_tar=False',
                '--scm-option', f'distgit_get=git clone --branch {branch} {repo_url} {package}',
                '--scm-option', f'distgit_src_get=spectool -g {package}.spec',
            ])
        elif source_type == 'git':
            mock_cmd.extend([
                '--scm-option', 'write_tar=True',
                '--scm-option', f'git_get=git clone --branch {branch} {repo_url} {package}',
            ])

        # Add additional repositories
        for repo_url in self.addrepo_urls:
            mock_cmd.extend(['--addrepo', repo_url])

        self.logger.debug(f"Executing mock command: {' '.join(mock_cmd)}")

        try:
            if self.verbose:
                # Show mock output in verbose mode
                subprocess.run(mock_cmd, check=True)
            else:
                # Capture output in normal mode
                result = subprocess.run(
                    mock_cmd,
                    check=True,
                    capture_output=True,
                    text=True
                )
                self.logger.info(f"Successfully built {package}")
                self.logger.debug(f"Mock output: {result.stdout}")
        except subprocess.CalledProcessError as e:
            self.logger.error(f"Failed to build {package}: {e}")
            if hasattr(e, 'stderr') and e.stderr:
                self.logger.error(f"Error output: {e.stderr}")
            sys.exit(1)

        # Build mock command
        mock_cmd = [
            'mock',
            '-r', base_config,
        ]

        # Find the src.rpm file
        print(f'globbing: {self.localrepo_path}/srpm/{package}*.src.rpm')
        src_rpm = glob.glob(f'{self.localrepo_path}/srpm/{package}*.src.rpm')[0]

        # Add localrepo and chain options
        if self.localrepo_path:
            mock_cmd.extend([
                f'--localrepo={self.localrepo_path}',
                '--chain',
                src_rpm,
            ])

        # Add any macro defines
        for define in self.mock_defines:
            mock_cmd.append(define)

        # Add additional repositories
        for repo_url in self.addrepo_urls:
            mock_cmd.extend(['--addrepo', repo_url])

        self.logger.debug(f"Executing mock command: {' '.join(mock_cmd)}")

        try:
            if self.verbose:
                # Show mock output in verbose mode
                subprocess.run(mock_cmd, check=True)
            else:
                # Capture output in normal mode
                result = subprocess.run(
                    mock_cmd,
                    check=True,
                    capture_output=True,
                    text=True
                )
                self.logger.info(f"Successfully built {package}")
                self.logger.debug(f"Mock output: {result.stdout}")
        except subprocess.CalledProcessError as e:
            self.logger.error(f"Failed to build {package}: {e}")
            if hasattr(e, 'stderr') and e.stderr:
                self.logger.error(f"Error output: {e.stderr}")
            sys.exit(1)

    def process_install(self) -> None:
        """Process the install section if present"""
        if 'install' not in self.config:
            self.logger.info("No install section found, skipping installation")
            return

        install_config = self.config['install']
        install_type = install_config.get('type', '')
        packages = install_config.get('packages', [])

        if not packages:
            self.logger.warning("Install section has no packages listed")
            return

        self.logger.info(f"Processing installation for type: {install_type}")
        self.logger.info(f"Packages to install: {', '.join(packages)}")

        # Install method depends on type
        if install_type == 'container':
            self._install_to_container(install_config, packages)
        elif install_type == 'flatpak':
            self._install_to_flatpak(install_config, packages)
        elif install_type == 'software-collection':
            self._install_scl(install_config, packages)
        elif install_type == 'package-collection':
            self._install_package_collection(install_config, packages)
        elif install_type == 'install-media':
            self._create_install_media(install_config, packages)
        elif install_type == 'live-usb':
            self._create_live_usb(install_config, packages)
        else:
            self.logger.warning(f"Install type '{install_type}' not yet implemented")

    def _install_to_container(self, config: Dict, packages: List[str]) -> None:
        """
        Install packages to a container image.

        Creates a container image with the specified packages installed from the
        local repository.

        Args:
            config: Install configuration with:
                - base_image: Base container image to use
                - tag: Tag for the resulting image
                - registry: (optional) Registry to push to
            packages: List of package names to install
        """
        # Validate required fields
        base_image = config.get('base_image')
        image_tag = config.get('tag')

        if not base_image:
            self.logger.error("Container install type requires 'base_image' field")
            sys.exit(1)
        if not image_tag:
            self.logger.error("Container install type requires 'tag' field")
            sys.exit(1)

        registry = config.get('registry')

        self.logger.info(f"Building container image: {image_tag}")
        self.logger.info(f"Base image: {base_image}")
        self.logger.info(f"Installing packages: {', '.join(packages)}")

        # Detect container runtime (prefer podman, fall back to docker)
        container_runtime = self._detect_container_runtime()
        self.logger.debug(f"Using container runtime: {container_runtime}")

        # Create a temporary directory for the build context
        with tempfile.TemporaryDirectory(prefix='rpm-build-container-') as build_dir:
            build_path = Path(build_dir)

            # Find the actual repository with RPMs (mock creates results/{config}/ subdirectory)
            base_config = self.config.get('base')
            repo_source = self.localrepo_path / 'results' / base_config

            if not repo_source.exists():
                self.logger.error(f"Repository not found at {repo_source}")
                self.logger.error("Ensure packages were built successfully before container installation")
                sys.exit(1)

            # Copy the actual repository (with RPMs and metadata) to build context
            localrepo_copy = build_path / 'localrepo'
            self.logger.info(f"Copying repository from {repo_source} to build context...")
            shutil.copytree(repo_source, localrepo_copy)

            # Create Containerfile/Dockerfile
            containerfile_path = build_path / 'Containerfile'
            self._create_containerfile(
                containerfile_path,
                base_image,
                packages
            )

            self.logger.debug(f"Created Containerfile at {containerfile_path}")

            # Build the container image
            self._build_container_image(
                container_runtime,
                build_path,
                image_tag,
                containerfile_path
            )

            # Push to registry if specified
            if registry:
                self._push_container_image(
                    container_runtime,
                    image_tag,
                    registry
                )

        self.logger.info(f"Successfully created container image: {image_tag}")
        if registry:
            full_image_name = f"{registry}/{image_tag}"
            self.logger.info(f"Pushed to registry: {full_image_name}")

    def _detect_container_runtime(self) -> str:
        """
        Detect available container runtime (podman or docker).

        Returns:
            'podman' or 'docker'

        Raises:
            SystemExit if neither is available
        """
        # Try podman first (preferred for rootless containers)
        try:
            result = subprocess.run(
                ['podman', '--version'],
                capture_output=True,
                text=True,
                timeout=5
            )
            if result.returncode == 0:
                return 'podman'
        except (FileNotFoundError, subprocess.TimeoutExpired):
            pass

        # Fall back to docker
        try:
            result = subprocess.run(
                ['docker', '--version'],
                capture_output=True,
                text=True,
                timeout=5
            )
            if result.returncode == 0:
                return 'docker'
        except (FileNotFoundError, subprocess.TimeoutExpired):
            pass

        self.logger.error("Neither podman nor docker found. Install one to build containers.")
        sys.exit(1)

    def _create_containerfile(self, path: Path, base_image: str, packages: List[str]) -> None:
        """
        Create a Containerfile for building the image.

        Args:
            path: Path where the Containerfile should be written
            base_image: Base container image
            packages: List of packages to install
        """
        package_list = ' '.join(packages)

        containerfile_content = f"""# Generated by rpm-build-assist
FROM {base_image}

# Copy local RPM repository
COPY localrepo /tmp/localrepo

# Create repository configuration for local builds
RUN echo -e '[local-builds]\\n\\
name=Local Built Packages\\n\\
baseurl=file:///tmp/localrepo\\n\\
enabled=1\\n\\
gpgcheck=0\\n\\
priority=1' > /etc/yum.repos.d/local-builds.repo

# Install packages from local repository
RUN dnf install -y {package_list} && \\
    dnf clean all && \\
    rm -rf /var/cache/dnf /tmp/localrepo

# Default command
CMD ["/bin/bash"]
"""

        with open(path, 'w') as f:
            f.write(containerfile_content)

        self.logger.debug(f"Containerfile content:\n{containerfile_content}")

    def _build_container_image(self, runtime: str, build_dir: Path,
                               tag: str, containerfile: Path) -> None:
        """
        Build the container image.

        Args:
            runtime: Container runtime to use ('podman' or 'docker')
            build_dir: Build context directory
            tag: Image tag
            containerfile: Path to Containerfile/Dockerfile
        """
        self.logger.info(f"Building container image with {runtime}...")

        build_cmd = [
            runtime,
            'build',
            '-t', tag,
            '-f', str(containerfile),
            str(build_dir)
        ]

        self.logger.debug(f"Build command: {' '.join(build_cmd)}")

        try:
            if self.verbose:
                # Show build output in verbose mode
                subprocess.run(build_cmd, check=True, cwd=build_dir)
            else:
                # Capture output in normal mode
                result = subprocess.run(
                    build_cmd,
                    check=True,
                    capture_output=True,
                    text=True,
                    cwd=build_dir
                )
                self.logger.debug(f"Build output: {result.stdout}")
        except subprocess.CalledProcessError as e:
            self.logger.error(f"Failed to build container image: {e}")
            if hasattr(e, 'stderr') and e.stderr:
                self.logger.error(f"Build error output: {e.stderr}")
            sys.exit(1)

    def _push_container_image(self, runtime: str, tag: str, registry: str) -> None:
        """
        Push the container image to a registry.

        Args:
            runtime: Container runtime to use ('podman' or 'docker')
            tag: Image tag
            registry: Registry to push to
        """
        # Construct full registry path
        # If tag already includes a registry, use it as-is
        # Otherwise, prepend the registry
        if '/' in tag and tag.split('/')[0].count('.') > 0:
            # Tag already includes registry (has domain with dots)
            full_tag = tag
        else:
            # Prepend registry
            full_tag = f"{registry.rstrip('/')}/{tag}"

        self.logger.info(f"Pushing image to registry: {full_tag}")

        # Tag the image with the registry path if different
        if full_tag != tag:
            tag_cmd = [runtime, 'tag', tag, full_tag]
            try:
                subprocess.run(tag_cmd, check=True, capture_output=True)
            except subprocess.CalledProcessError as e:
                self.logger.error(f"Failed to tag image: {e}")
                sys.exit(1)

        # Push the image
        push_cmd = [runtime, 'push', full_tag]

        self.logger.debug(f"Push command: {' '.join(push_cmd)}")

        try:
            if self.verbose:
                # Show push output in verbose mode
                subprocess.run(push_cmd, check=True)
            else:
                # Capture output in normal mode
                result = subprocess.run(
                    push_cmd,
                    check=True,
                    capture_output=True,
                    text=True
                )
                self.logger.debug(f"Push output: {result.stdout}")
        except subprocess.CalledProcessError as e:
            self.logger.error(f"Failed to push container image: {e}")
            if hasattr(e, 'stderr') and e.stderr:
                self.logger.error(f"Push error output: {e.stderr}")
            sys.exit(1)

